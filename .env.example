# 다가감 ver2 — 환경변수 (전부 선택 사항)
#
# ⚠️ 이 파일의 값을 하나도 채우지 않아도 앱은 100% 무료로 끝까지 동작합니다.
#    - 대화: mock/dialogueScripts.js 의 대화 트리
#    - 목소리: 브라우저 내장 한국어 음성 (Edge/Chrome의 신경망 음성 우선)
#
# 아래 값은 "더 좋게 만들고 싶을 때"만 채우세요. 전부 유료 API입니다.
# 키는 서버(api/ 폴더)에서만 읽히며 브라우저 번들에 들어가지 않습니다.
# 실제 사용 시에는 이 파일을 복사해 .env 로 만드세요. (.env 는 git에 올라가지 않습니다)

# ── 실제 AI 대화 ───────────────────────────────────────────────
# 둘 중 하나만 있으면 켜집니다. 응답이 7초 안에 안 오거나 실패하면
# 자동으로 스크립트로 되돌아갑니다.

# [무료] Google AI Studio — 카드 등록 없이 구글 계정만으로 키를 발급받습니다.
#        https://aistudio.google.com/apikey
#        ⚠️ 무료 요금제는 주고받은 내용이 구글의 모델 개선에 쓰일 수 있습니다.
#           이 키가 있으면 앱이 동의 화면에서 그 사실을 자동으로 안내합니다.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# [유료] Claude — 무료 요금제가 없습니다. 품질을 우선할 때만.
#        둘 다 있으면 위의 무료 쪽(Gemini)을 먼저 씁니다.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ── 성우급 TTS (셋 중 하나만) ─────────────────────────────────
# 하나라도 있으면 브라우저 음성 대신 이쪽을 씁니다.
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE_F=ko-KR-Neural2-A
# GOOGLE_TTS_VOICE_M=ko-KR-Neural2-C

# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID_F=
# ELEVENLABS_VOICE_ID_M=
